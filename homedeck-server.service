[Unit]
Description=HomeDeck API server (configuration editing + mDNS discovery)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# server.py calls load_dotenv(), which reads .env from this directory.
# Deliberately no EnvironmentFile=: systemd would keep the surrounding quotes
# in values like HA_HOST="ws://..." that python-dotenv strips.
WorkingDirectory=/app/homedeck
ExecStart=/app/homedeck-venv/bin/python -u /app/homedeck/server.py

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
