brightness: 90

sleep:
  dim_brightness: 20
  dim_timeout: 10
  sleep_timeout: 300

  # Optional time-of-day brightness windows (local time, 24h "HH:MM").
  # Windows may wrap past midnight; the first matching entry wins.
  # See configuration.wall-mount.yml.example for an always-on setup.
  schedule: []

system_buttons:
  $page.back:
    position: 1
  $page.previous:
    position: 2
  $page.next:
    position: 3

presets: {}

pages:
  $root:
    buttons:
      - text: Hello
        icon_background_color: b9003e

      - text: World!
        icon_background_color: b9003e
